From: Viktor Pashaiev <w.paszajew@gmail.com>
Date: Fri, 27 Nov 2026 17:50:45 +0100
Subject: fix(systemd-networkd): populate resolv.conf via
 initrd-resolvconf.path

When 11systemd-networkd is used without 11systemd-resolved (for example
in TEST-61-CHRONY on Debian and Ubuntu), /etc/resolv.conf is never
created in the initramfs, so chronyd fails to resolve pool.ntp.org and
chrony-wait.service times out.

When systemd-resolved is not included, symlink /etc/resolv.conf to
/run/initramfs/resolv.conf and install initrd-resolvconf.path and
initrd-resolvconf.service to populate /run/initramfs/resolv.conf from
kernel command-line nameserver= arguments and /run/systemd/netif/state
DNS= entries whenever /run/systemd/netif/state is updated.

Fixes: https://github.com/dracut-ng/dracut/issues/2541
Bug-Debian: https://bugs.debian.org/1155542
Bug-Ubuntu: https://launchpad.net/bugs/2178220
Origin: upstream, https://github.com/dracut-ng/dracut/pull/2845
---
 modules.d/11systemd-networkd/initrd-resolvconf.path    | 10 ++++++++++
 modules.d/11systemd-networkd/initrd-resolvconf.service |  8 ++++++++
 modules.d/11systemd-networkd/module-setup.sh           |  8 ++++++++
 modules.d/11systemd-networkd/networkd-resolv.sh        | 11 +++++++++++
 4 files changed, 37 insertions(+)
 create mode 100644 modules.d/11systemd-networkd/initrd-resolvconf.path
 create mode 100644 modules.d/11systemd-networkd/initrd-resolvconf.service
 create mode 100755 modules.d/11systemd-networkd/networkd-resolv.sh

diff --git a/modules.d/11systemd-networkd/initrd-resolvconf.path b/modules.d/11systemd-networkd/initrd-resolvconf.path
new file mode 100644
index 0000000..b46d5b5
--- /dev/null
+++ b/modules.d/11systemd-networkd/initrd-resolvconf.path
@@ -0,0 +1,10 @@
+[Unit]
+Description=Watch systemd-networkd state for DNS updates
+DefaultDependencies=no
+Before=paths.target systemd-networkd.service
+
+[Path]
+PathModified=/run/systemd/netif/state
+
+[Install]
+WantedBy=sysinit.target
diff --git a/modules.d/11systemd-networkd/initrd-resolvconf.service b/modules.d/11systemd-networkd/initrd-resolvconf.service
new file mode 100644
index 0000000..adb2fc0
--- /dev/null
+++ b/modules.d/11systemd-networkd/initrd-resolvconf.service
@@ -0,0 +1,8 @@
+[Unit]
+Description=Populate /run/initramfs/resolv.conf from systemd-networkd state
+DefaultDependencies=no
+Before=nss-lookup.target
+
+[Service]
+Type=oneshot
+ExecStart=/usr/lib/dracut/networkd-resolv.sh
diff --git a/modules.d/11systemd-networkd/module-setup.sh b/modules.d/11systemd-networkd/module-setup.sh
index 484ccd3..b550430 100755
--- a/modules.d/11systemd-networkd/module-setup.sh
+++ b/modules.d/11systemd-networkd/module-setup.sh
@@ -72,6 +72,14 @@ install() {
     inst_hook cmdline 99 "$moddir"/networkd-config.sh
     inst_hook initqueue/settled 99 "$moddir"/networkd-run.sh
 
+    if ! dracut_module_included "systemd-resolved"; then
+        inst_script "$moddir"/networkd-resolv.sh /usr/lib/dracut/networkd-resolv.sh
+        inst_simple "$moddir"/initrd-resolvconf.path "$systemdsystemunitdir"/initrd-resolvconf.path
+        inst_simple "$moddir"/initrd-resolvconf.service "$systemdsystemunitdir"/initrd-resolvconf.service
+        $SYSTEMCTL -q --root "$initdir" enable initrd-resolvconf.path
+        ln_r /run/initramfs/resolv.conf /etc/resolv.conf
+    fi
+
     # Enable systemd type units
     for i in \
         systemd-networkd.service \
diff --git a/modules.d/11systemd-networkd/networkd-resolv.sh b/modules.d/11systemd-networkd/networkd-resolv.sh
new file mode 100755
index 0000000..491f964
--- /dev/null
+++ b/modules.d/11systemd-networkd/networkd-resolv.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+
+[ -r /run/systemd/netif/state ] || exit 0
+
+command -v getargs > /dev/null || . /lib/dracut-lib.sh
+
+mkdir -p /run/initramfs
+for s in $(getargs nameserver) $(sed -n "s/^DNS=//p" /run/systemd/netif/state); do
+    echo "nameserver $s"
+done > /run/initramfs/resolv.conf.tmp
+mv /run/initramfs/resolv.conf.tmp /run/initramfs/resolv.conf
